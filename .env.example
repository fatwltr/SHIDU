# Local mode is the default. Set these as process environment variables.
# The server does not automatically load .env files.
RSS_PORT=8787
RSS_BIND=127.0.0.1
# RSS_DATA_DIR=/var/lib/shidu-rss

# Remote access requires all four settings below, a matching public origin,
# and an independently generated access password. Never commit real values.
# RSS_BIND=0.0.0.0
# RSS_PUBLIC_ORIGIN=https://reader.example.com:8787
# RSS_AUTH_USER=reader
# RSS_AUTH_PASSWORD=replace-with-a-new-random-password
# RSS_TLS_CERT=/etc/shidu-rss/server.crt
# RSS_TLS_KEY=/etc/shidu-rss/server.key
