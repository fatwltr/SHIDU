[Unit]
Description=Shidu RSS reader
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=shidu-rss
Group=shidu-rss
WorkingDirectory=/opt/shidu-rss
EnvironmentFile=/etc/shidu-rss/server.env
ExecStart=/usr/bin/node /opt/shidu-rss/.local/server.mjs
Restart=on-failure
RestartSec=5
UMask=0027
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/shidu-rss
MemoryMax=512M

[Install]
WantedBy=multi-user.target
