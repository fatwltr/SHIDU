{
  "name": "shidu-rss",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "拾读：支持 RSSHub、标签筛选和多主题的每日 RSS 阅读器",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "node scripts/build-local.mjs",
    "start": "node .local/server.mjs",
    "local:build": "node scripts/build-local.mjs",
    "local:start": "node .local/server.mjs",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-isolation=none tests/rss.test.mjs tests/rsshub.test.mjs tests/reader-navigation.test.mjs tests/retention.test.mjs",
    "test:auth": "node tests/remote-auth.mjs"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "4.20260515.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "esbuild": "0.28.2",
    "jsdom": "26.1.0",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
